)); opacity:.92; }\n      14% { transform: translate(var(--xr),4px) rotate(var(--counter)); opacity:1; }\n      18% { transform: translate(0,-6px) rotate(calc(var(--tilt) * 0.35)); }\n      22% { transform: translate(0,2px) rotate(calc(var(--counter) * 0.35)); }\n      26% { transform: translate(0,0) rotate(0deg); }\n      58% { transform: translate(calc(var(--x) * 0.45),-6px) rotate(calc(var(--tilt) * 0.45)); }\n      62% { transform: translate(var(--xr),1px) rotate(calc(var(--counter) * 0.4)); }\n      67% { transform: translate(0,0) rotate(0deg); }\n    }\n    @keyframes lensPlay {\n      0%, 4%, 100% { transform: translate(0,0) rotate(0deg); }\n      7%  { transform: translate(-2px,-3px) rotate(-8deg); }\n      11% { transform: translate(3px,1px) rotate(6deg); }\n      16% { transform: translate(-1px,-2px) rotate(-3deg); }\n      21% { transform: translate(0,1px) rotate(1.2deg); }\n      26% { transform: translate(0,0) rotate(0deg); }\n      58% { transform: translate(-1px,-1px) rotate(-3.5deg); }\n      62% { transform: translate(1px,0) rotate(2deg); }\n      67% { transform: translate(0,0) rotate(0deg); }\n    }\n    @keyframes dotPlay {\n      0%, 4%, 100% { transform: translateY(0) rotate(0deg); }\n      8%  { transform: translateY(-12px) rotate(8deg); }\n      12% { transform: translateY(4px) rotate(-4deg); }\n      16% { transform: translateY(-6px) rotate(2deg); }\n      20% { transform: translateY(1px) rotate(-1deg); }\n      24% { transform: translateY(0) rotate(0deg); }\n      58% { transform: translateY(-6px) rotate(3deg); }\n      62% { transform: translateY(1px) rotate(-1deg); }\n      67% { transform: translateY(0) rotate(0deg); }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      .main-letter,.sub-letter,.lens-inner,.idot-inner { animation:none !important; }\n    }\n  </style>\n  <g fill-rule=\"evenodd\">\n    <g class=\"main-letter\" style=\"--tilt:-3.0deg;--counter:1.2deg;--settle:-0.5deg;--x:-3px;--xr:1px;animation-delay:0.0s\">\n     